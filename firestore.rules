rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsUser(uid) { return signedIn() && request.auth.uid == uid; }
    function isVeterinarian() {
      return signedIn() && request.auth.token.role == 'VETERINARIAN';
    }

    match /users/{uid} {
      // Vets can review farmer profiles in this single cooperative project.
      allow read: if ownsUser(uid) || isVeterinarian();
      allow create: if ownsUser(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'FARMER';
      allow update: if ownsUser(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;

      match /workspace/{workspaceId}/records/{recordId} {
        allow read, write: if ownsUser(uid) || isVeterinarian();
      }
      match /workspace/{workspaceId}/config/{documentId} {
        allow read, write: if ownsUser(uid) || isVeterinarian();
      }
      match /workspace/{workspaceId}/meta/{documentId} {
        allow read, write: if ownsUser(uid) || isVeterinarian();
      }
    }

    // Signed-in farmers can choose a vetted professional. Only Admin SDK can mutate it.
    match /veterinarians/{uid} {
      allow read: if signedIn();
      allow create, delete: if false;
      allow update: if isVeterinarian()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'VETERINARIAN'
        && request.resource.data.email == resource.data.email;
    }
  }
}
