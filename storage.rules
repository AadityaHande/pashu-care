rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function ownsUser(uid) { return signedIn() && request.auth.uid == uid; }
    function isVeterinarian() { return signedIn() && request.auth.token.role == 'VETERINARIAN'; }
    match /users/{uid}/{allPaths=**} {
      allow read: if ownsUser(uid) || isVeterinarian();
      allow create, update: if (ownsUser(uid) || isVeterinarian())
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if ownsUser(uid) || isVeterinarian();
    }
  }
}
