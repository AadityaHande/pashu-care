# Firebase Web App configuration
# Firebase Console -> Project settings -> Your apps -> Web app
# Google OAuth uses the same Firebase web app config; no Google client secret is placed here.
# These NEXT_PUBLIC values are client config, not service-account secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Do not add a Firebase Admin service-account key to NEXT_PUBLIC variables.
# The optional tools/admin script uses Application Default Credentials locally.

# Presentation-only mode is enabled by default when Firebase is not configured.
# Set to false to show the Firebase setup screen instead. It never changes Firebase auth behavior when Firebase is configured.
NEXT_PUBLIC_PASHUCARE_DEMO_MODE=true
